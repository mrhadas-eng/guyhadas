rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // GuyHadas Visibility OS + the public-site admin dashboard share this
    // same allowlist. Not just "any authenticated user" - Email/Password
    // sign-up is public by default, so this must check specific addresses,
    // not just `auth != null`. Generalized from a single hardcoded email so
    // more GuyHadas users can be added later without restructuring rules -
    // still a flat allowlist on purpose (spec: don't build RBAC yet).
    function isAdmin() {
      return request.auth != null
             && request.auth.token.email in ['mr.hadas@gmail.com'];
    }

    // Default deny for anything not explicitly opened below.
    match /{document=**} {
      allow read, write: if false;
    }

    match /leads/{leadId} {
      // Public: the landing-page form (and the no-id prep.html fallback)
      // creates a new lead. Validated shape, same as before.
      allow create: if request.resource.data.fullName is string
                    && request.resource.data.fullName.size() >= 2
                    && request.resource.data.phone is string;

      // Public: prep.html and book.html read one lead by its own id (the id
      // acts as a bearer token - see the note on lead-id generation) and may
      // only touch the handful of fields the client flow actually writes,
      // moving "status" only to the values that flow legitimately sets.
      // Admin (the dashboard) can update any field to any value, e.g. the
      // status dropdown's full set of options.
      allow get: if true;
      allow update: if isAdmin()
                    || (request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['intakeAnswers', 'intakeSubmittedAt', 'intakeSubmittedDate',
                                    'status', 'meetingSlot'])
                        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['status'])
                            || request.resource.data.status in ['prep_done', 'meeting_set']));

      // Admin only: see every lead at once, or remove one.
      allow list: if isAdmin();
      allow delete: if isAdmin();
    }

    // Intake questions shown on prep.html - public read (it's the public
    // form itself), admin-only write (that's the question-set editor).
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Calendar bookings & slot locks. Each doc carries the client's name/
    // phone/email, so any read of more than "does this exact id exist" is
    // admin-only. Nothing in the current app reads a single booking by id
    // either, so both get and list are locked down. The public booking flow
    // only ever creates a fresh slot lock, never edits or removes one - and
    // getAvailableSlots runs server-side with the Admin SDK, which always
    // bypasses these rules regardless.
    match /bookings/{bookingId} {
      allow get, list: if isAdmin();
      allow create: if request.resource.data.startIso is string
                    && request.resource.data.endIso is string;
      allow update, delete: if isAdmin();
    }

    // --- GuyHadas Visibility OS (app.guyhadas.xyz) ---
    // Entirely private/internal - everything below is admin-only, both
    // reads and writes. No public-facing collection here, unlike leads/
    // bookings/settings above which the marketing site writes to directly.

    match /businesses/{businessId} {
      allow read, write: if isAdmin();
    }

    match /tasks/{taskId} {
      allow read, write: if isAdmin();
    }

    // Manual opportunities stay fully owner-managed. Opportunities written by
    // the M5 Opportunity Engine (source "opportunity_engine", Admin SDK only)
    // carry evidence and scores that must stay intact: clients cannot create
    // or delete them and may update only the owner fields (status, notes).
    match /opportunities/{opportunityId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && request.resource.data.get("source", "manual") != "opportunity_engine";
      allow update: if isAdmin() && (
        resource.data.get("source", "manual") != "opportunity_engine"
          ? request.resource.data.get("source", "manual") != "opportunity_engine"
          : request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "ownerNote", "updatedAt"])
      );
      allow delete: if isAdmin() && resource.data.get("source", "manual") != "opportunity_engine";
    }

    // One record per Opportunity Engine run (topic outcomes incl. NO_ACTION).
    // Written only by the Cloud Function.
    match /opportunityRuns/{runId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // --- M6 Decision Engine (docs/M6_DECISION_ENGINE_DESIGN.md §J) ---
    // SearchIntents and decision runs are engine-generated (Admin SDK only).
    match /searchIntents/{intentId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /decisionRuns/{runId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // One-run-per-business lease lock (Admin SDK only).
    match /decisionRunLocks/{businessId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Decisions: the engine writes everything; the owner may only record
    // their review (ownerStatus, ownerNote). Evidence, reasons, ownership,
    // collision and history cannot be changed, created or deleted by a client.
    match /decisions/{decisionId} {
      allow read: if isAdmin();
      allow create, delete: if false;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["ownerStatus", "ownerNote", "updatedAt"])
        && request.resource.data.get("ownerStatus", "pending") in ["pending", "accepted", "rejected", "deferred"];
    }

    // --- M7 Prediction, Change & Experiment Tracking (docs/M7_DESIGN.md §12) ---
    // Predictions are engine-generated (content create-only, lifecycle fields
    // server-side). No client can create or alter confidence, ranges,
    // model/config versions, implementation status, verification, time
    // state, holds, attribution or outcome.
    match /impactPredictions/{predictionId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Change events are created only by visibilityRecordImplementation (the
    // validated, owner_reported implementation facts). The owner may later
    // edit only the free-text implementation notes.
    match /seoChangeEvents/{changeEventId} {
      allow read: if isAdmin();
      allow create, delete: if false;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["implementationNotes", "updatedAt"])
        && request.resource.data.implementationNotes is string
        && request.resource.data.implementationNotes.size() <= 2000;
    }

    // Experiments are engine-generated. The owner's only control is an
    // explicit hold release with a note (P2: durable for the experiment's
    // lifetime - it cannot be withdrawn from the client). M8 outcome fields
    // stay null until M8 writes them server-side.
    match /seoExperiments/{experimentId} {
      allow read: if isAdmin();
      allow create, delete: if false;
      allow update: if isAdmin()
        && resource.data.status == "open"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["ownerHoldRelease", "updatedAt"])
        && request.resource.data.ownerHoldRelease is map
        && request.resource.data.ownerHoldRelease.keys().hasOnly(["released", "note", "atMs"])
        && request.resource.data.ownerHoldRelease.released == true
        && request.resource.data.ownerHoldRelease.note is string
        && request.resource.data.ownerHoldRelease.note.size() > 0
        && request.resource.data.ownerHoldRelease.note.size() <= 500;
    }

    match /trackingRuns/{runId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /trackingRunLocks/{businessId} {
      allow read, write: if false;
    }

    // Semrush API unit balance snapshots (append-only, written only by
    // visibilityGetSemrushBalance via the Admin SDK). Contain only
    // {balance, checkedAt, source} - never the API key.
    match /semrushBalanceSnapshots/{snapshotId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Reserved for M8 measurement - never created by M7, never client-written.
    match /impactObservations/{observationId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /experimentOutcomes/{outcomeId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Integration status docs (ga4/search_console/semrush/...). Read-only
    // for clients as of Milestone 2: writes now happen exclusively through
    // the visibilityConnectIntegration / visibilitySyncGa4 /
    // visibilitySyncSearchConsole / visibilityDisconnectIntegration Cloud
    // Functions (functions/visibility.js), which use the Admin SDK and so
    // bypass this rule anyway. Blocking direct client writes here matters:
    // without it, the UI (or anyone with console access) could write a fake
    // "connected" status without ever calling a real Google API.
    match /integrations/{integrationId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Normalized Google-data snapshots (Milestone 2). Written only by the
    // visibilitySyncGa4 / visibilitySyncSearchConsole Cloud Functions via
    // the Admin SDK - never directly by a client, same reasoning as
    // `integrations` above. Admin can read them once the dashboard/tab UI
    // for this data is built (Milestone 3).
    match /trafficSnapshots/{snapshotId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /searchSnapshots/{snapshotId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // --- Business & Service Discovery (roadmap Milestone 3.1) ---
    // Business Understanding -> Service Map -> (owner validation) -> Search
    // Discovery seeds. Client-writable by the admin, same posture as
    // searchTopics below: owner validation (confirm/reject/edit a proposed
    // service, manual service add) is a direct Firestore write from the
    // Topics tab. The visibilityAnalyzeBusiness Cloud Function
    // (functions/businessUnderstanding.js) also writes here via the Admin
    // SDK, which bypasses this rule regardless.
    match /businessServices/{serviceId} {
      allow read, write: if isAdmin();
    }

    // --- Search Universe & Qualification (roadmap Milestone 3.2) ---
    // Search Discovery → Filtering → Normalization → Owner Validation →
    // Approved Search Universe. Unlike integrations/trafficSnapshots/
    // searchSnapshots above, these four ARE client-writable by the admin:
    // owner validation (approve/reject/prioritize/brand-strategic/unsure,
    // manual topic/keyword add, business-knowledge entries like exclusion
    // rules) is a direct Firestore write from the Topics tab, not a Cloud
    // Function call. The discovery functions (visibilityDiscoverFromSearchConsole/
    // Semrush, functions/searchUniverse.js) also write here, using the
    // Admin SDK, which bypasses these rules regardless.

    match /businessKnowledge/{knowledgeId} {
      allow read, write: if isAdmin();
    }

    match /searchTopics/{topicId} {
      allow read, write: if isAdmin();
    }

    match /keywords/{keywordId} {
      allow read, write: if isAdmin();
    }

    match /competitors/{competitorId} {
      allow read, write: if isAdmin();
    }

    // --- Search Intelligence & Baseline (roadmap M4) ---
    // Derived intelligence, written only by visibilityRunSearchIntelligence /
    // visibilityCaptureBaseline (functions/searchIntelligenceStore.js) via
    // the Admin SDK. Read-only for clients: intelligence must come from
    // real observations, never a client write.
    match /seoPages/{pageId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /topicIntelligence/{intelId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /intelligenceRuns/{runId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Baselines are IMMUTABLE (MASTER §38.5): no client write of any kind,
    // and the server only ever creates a new version (create-only), never
    // updates or deletes one.
    match /baselines/{baselineId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // --- Universal External API Cost-Control Rule (permanent project
    // rule - see claude/visibility-os-api-cost-control-rule.md) ---
    // apiUsage is the ledger/cache every governed provider call
    // (functions/apiUsage.js's runGoverned) reads and writes, via the
    // Admin SDK only - same posture as integrations/trafficSnapshots/
    // searchSnapshots above: admin can read it (for cost/usage
    // inspection), nothing is ever client-written. apiCircuitBreakers is
    // the small per-provider/operation failure-streak doc the same module
    // uses; no reason for a client to read or write it directly either.
    match /apiUsage/{usageId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /apiCircuitBreakers/{breakerId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // One record per business-analysis run (crawl report + results),
    // written only by functions/businessUnderstanding.js via the Admin SDK.
    // Kept permanently - historical data is permanent per the roadmap.
    match /businessAnalysisRuns/{runId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // metrics / aiVisibilitySnapshots / contentAssets / experiments (legacy
    // name - M7 uses seoExperiments) /
    // recommendations are not yet read or written by any client - left to
    // the blanket default-deny above until a later milestone actually
    // introduces them, same as everywhere else in this file.
  }
}
